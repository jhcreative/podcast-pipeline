# /opt/rockstar-pipeline/.env.example
# Copy to /opt/rockstar-pipeline/.env and fill in all values.
# chmod 600 /opt/rockstar-pipeline/.env
# chown rockstar:rockstar /opt/rockstar-pipeline/.env

# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Hugging Face (for pyannote diarization in whisperx) ───────────────────────
HF_TOKEN=hf_...

# ── Google service account ─────────────────────────────────────────────────────
# Path to the service account JSON key file (chmod 600, owned by rockstar)
GCP_SA_KEY_PATH=/opt/rockstar-pipeline/gcp-sa.json

# Gmail address to impersonate via domain-wide delegation
# (the human mailbox the service account acts on behalf of)
GMAIL_USER=heather@example.test

# ── Google Drive folder IDs ────────────────────────────────────────────────────
# Find these in the Drive URL when you open the folder:
#   https://drive.google.com/drive/folders/{FOLDER_ID}
DRIVE_RECORDINGS_INBOX_FOLDER_ID=
DRIVE_EPISODES_FOLDER_ID=
DRIVE_ROOT_FOLDER_ID=

# ── Gmail Pub/Sub ──────────────────────────────────────────────────────────────
# Full topic name: projects/{project_id}/topics/{topic_name}
GMAIL_PUBSUB_TOPIC=projects/rockstar-pipeline/topics/gmail-notifications

# Subscription name suffix (last component of the full subscription name)
# Full: projects/{project_id}/subscriptions/{subscription_name}
GMAIL_PUBSUB_SUBSCRIPTION=gmail-push-sub

# SEC-01: the push subscription must send an OIDC token ("Enable authentication" on the subscription).
# The webhook verifies it (Google-signed, this audience, this service account) and refuses to start
# while any of these is unset. The audience is whatever the subscription is set to send; if left blank
# there, Google uses the push endpoint URL.
PUBSUB_PUSH_AUDIENCE=https://pipeline.example.test/webhook/gmail
PUBSUB_PUSH_SA_EMAIL=

# ── Google Calendar ────────────────────────────────────────────────────────────
# Use "primary" or paste the calendar ID from Calendar settings
GOOGLE_CALENDAR_ID=primary

# ET offset from UTC (EST = -5, EDT = -4). Used for scheduling editorial events.
ET_UTC_OFFSET=-5

# ── Webhook security ───────────────────────────────────────────────────────────
# Random string used as X-Goog-Channel-Token for Drive webhook validation.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SHARED_SECRET=
# SEC-01: required. Unset used to mean "accept every Drive webhook"; now the service will not start.

# ── Service URLs ───────────────────────────────────────────────────────────────
PUBLIC_HOSTNAME=pipeline.example.test

# ── Blog (BLOG-02) ────────────────────────────────────────────────────────────
# The PUBLIC blog base the post URL is built on (AC-6). Default is right; an old
# BLOG_BASE_URL=…/the-blog left in the box .env overrides it and must be removed.
# BLOG_BASE_URL=https://rockstarblends.com/blog
# The Tailor site the draft is written to. https + allow-listed host only
# (tailor_client.ALLOWED_HOSTS).
# BLOG_API_BASE=https://rockstarblends.com
#
# The blog CREDENTIAL does NOT go in this file (Orly C-10): this .env is loaded by the
# public webhook service too. It lives in /etc/rockstar-pipeline/tailor-blog.env
# (root:root 0600), loaded ONLY by rockstar-worker.service — preferably as
#   LoadCredential=tailor_blog:/etc/rockstar-pipeline/tailor-blog.env
# (read from $CREDENTIALS_DIRECTORY/tailor_blog), else a worker-only EnvironmentFile=.
# Keys: TAILOR_BLOG_EMAIL, TAILOR_BLOG_PASSWORD.

# ── Paths (defaults work with the standard layout; override for dev) ───────────
# DB_PATH=/opt/rockstar-pipeline/state/jobs.db
# RUN_LOG_PATH=/opt/rockstar-pipeline/state/run_log.jsonl
# WATCH_STATE_PATH=/opt/rockstar-pipeline/state/watch_state.json
# PROMPTS_DIR=/opt/rockstar-pipeline/prompts

# ── Worker tuning ──────────────────────────────────────────────────────────────
# WORKER_POLL_INTERVAL=10          # seconds between queue polls
# WORKER_MAX_ATTEMPTS=5            # 5 attempts, then permanently fail
# WORKER_STALE_JOB_MINUTES=30      # reclaim running jobs stuck > 30 min

# ── Script environment (injected by systemd worker.service) ───────────────────
# VENV_PATH=/opt/rockstar-pipeline/scripts/whisperx_env
# WORK_DIR_BASE=/tmp
# BRAND_ASSETS_DIR=/opt/rockstar-pipeline/BrandAssets
# FFMPEG_BIN=/usr/bin/ffmpeg

# ── Logging ────────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
